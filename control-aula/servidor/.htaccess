# ====================================================================
# Configuración Apache raíz para el despliegue del servidor
# Protege directorios privados y reenvía tráfico a public/
# ====================================================================

Options -Indexes
ServerSignature Off

# Bloquear acceso a archivos y carpetas sensibles
<FilesMatch "^\.(htaccess|htpasswd|env|git)|.*\.(sql|ini|log|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS (descomentar si el certificado SSL está activo en el hosting)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Proteger carpetas internas
    RewriteRule ^app/ - [F,L]
    RewriteRule ^sql/ - [F,L]

    # Si la petición no entra por public/ redirigir a public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^$ public/index.php [L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
